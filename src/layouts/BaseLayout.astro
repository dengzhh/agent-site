---
import Logo from '../components/Logo.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
// 根部署时为 '/'，GitHub Pages 子路径部署时为 '/agent-site/'——所有内部链接统一走它
const BASE_URL = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={BASE_URL + 'favicon.svg'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <style is:global>@import '../styles/global.css';</style>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={BASE_URL}>
        <Logo size={30} />
        <span class="brand-name">Agent<em>Toolbox</em></span>
      </a>
      <nav aria-label="Tools">
        {[
          { href: BASE_URL + 'free-models/', label: 'Free Models' },
          { href: BASE_URL + 'tools/llm-api-cost-calculator/', label: 'Cost Calculator' },
          { href: BASE_URL + 'tools/token-estimator/', label: 'Token Estimator' },
          { href: BASE_URL + 'tools/system-prompt-generator/', label: 'Prompt Generator' },
          { href: BASE_URL + 'tools/mcp-config-generator/', label: 'MCP Config' },
          { href: BASE_URL + 'compare/agent-frameworks/', label: 'Frameworks' },
        ].map((item) => (
          <a href={item.href} aria-current={Astro.url.pathname.replace(/\/$/, '') === item.href.replace(/\/$/, '') ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} AgentToolbox · <a href={BASE_URL + 'about/'}>About</a> · <a href={BASE_URL + 'privacy/'}>Privacy</a> · <a href={BASE_URL + 'contact/'}>Contact</a></p>
    </footer>
  </body>
</html>
