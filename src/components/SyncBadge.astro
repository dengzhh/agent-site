---
// 数据新鲜度徽章：三个数据页共用，标明数据最后同步时间与来源。
// date 必填（ISO 或 YYYY-MM-DD）；detail 可选，说明同步方式/来源。
interface Props {
  date: string;
  detail?: string;
}
const { date, detail } = Astro.props;
const day = date.slice(0, 10);
---
<span class="sync-badge">
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="sync-badge__icon">
    <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  Data updated <time datetime={day}>{day}</time>{detail && <> · {detail}</>}
</span>

<style>
  .sync-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--cobalt);
    background: var(--cobalt-wash);
    border: 1px solid var(--cobalt);
    border-radius: 999px;
    padding: 0.28rem 0.85rem;
    margin: 0 0 1rem;
  }
  .sync-badge__icon { flex: none; }
</style>
