---
import BaseLayout from '../layouts/BaseLayout.astro';
import SyncBadge from '../components/SyncBadge.astro';
import data from '../data/free-models.json';
import type { FreeModelsIndex } from '../lib/free-models';
const idx = data as FreeModelsIndex;

// 展示词与 data-caps 筛选键不同：reason → reasoning、open-weights → open（见下方 tr 的 data-caps）
const caps = (m: { toolCall: boolean; reasoning: boolean; attachment: boolean; openWeights: boolean }) =>
  [m.toolCall && 'tools', m.reasoning && 'reason', m.attachment && 'vision', m.openWeights && 'open-weights']
    .filter(Boolean) as string[];

const fmtCtx = (n: number) =>
  n >= 1e6 ? `${(n / 1048576).toFixed(1).replace(/\.0$/, '')}M` : n >= 1000 ? `${Math.round(n / 1024)}K` : String(n);
---
<BaseLayout
  title="Free LLM Models — Every Zero-Cost API Model in One Table"
  description="All free LLM API models from OpenRouter, Nvidia, Groq, Mistral, Z.ai and more: context windows, tool calling, and one-click config snippets for Claude Code and Codex. Synced daily."
>
  <h1>Free LLM models</h1>
  <SyncBadge date={idx.syncedAt} detail="auto-synced daily from models.dev + OpenRouter" />
  <p>Every model below costs exactly $0 per token, aggregated from {idx.providers.length} providers. Generate ready-to-paste config for Claude Code, Codex CLI, or your own code.</p>
  <p class="muted-note">
    "Free" means $0 input and $0 output — rate limits still apply per provider.
  </p>

  <nav class="cap-filter" aria-label="Filter by capability">
    <button type="button" class="cap-chip is-active" aria-pressed="true" data-cap="all">All {idx.totalFree}</button>
    <button type="button" class="cap-chip" aria-pressed="false" data-cap="tools">Tool calling</button>
    <button type="button" class="cap-chip" aria-pressed="false" data-cap="reasoning">Reasoning</button>
    <button type="button" class="cap-chip" aria-pressed="false" data-cap="vision">Vision</button>
    <button type="button" class="cap-chip" aria-pressed="false" data-cap="long">Long context ≥400K</button>
    <button type="button" class="cap-chip" aria-pressed="false" data-cap="open">Open weights</button>
  </nav>
  <p id="filter-status" class="muted-note" role="status" aria-live="polite"></p>

  {idx.providers.map((p) => (
    <section class="provider" data-provider={p.id}>
      <h2>{p.modelsUrl ? <a href={p.modelsUrl} target="_blank" rel="noopener">{p.name}</a> : p.name} <span class="count">{p.models.length} free</span></h2>
      {p.note && <p class="muted-note">{p.note}</p>}
      <div class="tablewrap">
        <table>
          <colgroup>
            {/* 内联 width：scoped class 对 <col> 的属性传播不可靠 */}
            <col style="width:auto" /><col style="width:6.5rem" /><col style="width:6.5rem" /><col style="width:11rem" /><col style="width:6rem" /><col style="width:11.5rem" />
          </colgroup>
          <thead><tr>
            <th scope="col">Model</th><th scope="col" class="num">Context</th>
            <th scope="col" class="num">Max out</th><th scope="col">Capabilities</th>
            <th scope="col">Updated</th><th scope="col">Config</th>
          </tr></thead>
          <tbody>
            {p.models.map((m) => (
              // data-caps 键与上面 caps() 的展示词不同：reasoning ↔ reason、open ↔ open-weights
              <tr data-caps={[
                    m.toolCall && 'tools', m.reasoning && 'reasoning',
                    m.attachment && 'vision', m.openWeights && 'open',
                    m.context >= 400000 && 'long',
                  ].filter(Boolean).join(' ')}>
                <td class="col-model">
                  {m.detailUrl ? <a href={m.detailUrl} target="_blank" rel="noopener" title="官方模型详情（介绍/定价）">{m.name}</a> : m.name}
                  <code class="model-id">{m.id}</code>
                </td>
                <td class="num">{fmtCtx(m.context)}</td>
                <td class="num">{fmtCtx(m.maxOutput)}</td>
                <td>{caps(m).length ? caps(m).join(' · ') : '—'}</td>
                <td>{m.lastUpdated ? m.lastUpdated.slice(0, 7) : '—'}</td>
                <td class="col-config">
                  <button type="button" class="pick" data-provider={p.id} data-model={m.id} data-name={m.name}>Configure</button>
                  {p.id !== 'github-copilot' && (
                    <button type="button" class="chat-pick" data-provider={p.id} data-model={m.id}
                      data-base={p.api ?? ''} data-anthropic={p.anthropicApi ?? ''} data-envkey={p.envKey} data-ctx={m.context} data-maxout={m.maxOutput}
                      data-agents={m.agents?.join(',') || 'pi'}
                      data-name={m.name}>Chat</button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <aside id="config-drawer" class="config-drawer" aria-label="Generate config" aria-hidden="true">
    <header class="chat-head">
      <div><strong>Config for this model</strong><div class="chat-sub">Key is merged in your browser only</div></div>
      <button id="config-close" type="button" class="drawer-close" aria-label="Close config">✕</button>
    </header>
    <div class="config-body">
      <p class="chat-sub" id="config-pick-label"></p>
      <form id="gen-form">
        <div class="field-row">
          <div>
            <label for="g-provider">Provider</label>
            <select id="g-provider">
              {idx.providers.map((p) => <option value={p.id}>{p.name}</option>)}
            </select>
          </div>
          <div>
            <label for="g-model">Model</label>
            <select id="g-model"></select>
          </div>
        </div>
        <div class="field-row">
          <div>
            <label for="g-key">API key (optional, local only)</label>
            <input id="g-key" type="password" placeholder="paste your key — stays in your browser" autocomplete="off" />
          </div>
          <div>
            <label for="g-target">Target</label>
            <select id="g-target">
              <option value="claude-code">Claude Code (settings.json)</option>
              <option value="codex">Codex CLI (config.toml)</option>
              <option value="env">Shell env vars</option>
              <option value="ai-sdk">AI SDK (TypeScript)</option>
            </select>
          </div>
        </div>
        <button type="submit">Generate</button>
      </form>
      <pre id="g-out" class="result" aria-live="polite"></pre>
      <button id="g-copy" type="button" hidden>Copy</button>
    </div>
  </aside>

  <aside id="chat-drawer" aria-label="Chat with this model" aria-hidden="true">
    <header class="chat-head">
      <div><strong id="chat-model-name"></strong><div id="chat-provider-name" class="chat-sub"></div></div>
      <button id="chat-close" type="button" aria-label="Close chat">✕</button>
    </header>
    <div class="chat-agent-row" id="chat-agent-row" hidden>
      <label for="chat-agent">Agent</label>
      <select id="chat-agent" class="chat-agent"></select>
    </div>
    <p id="chat-agent-hint" class="chat-agent-hint" hidden></p>
    <div class="chat-config-row" id="chat-config-row" hidden>
      <label for="chat-cwd">Work dir</label>
      <input id="chat-cwd" type="text" placeholder="/home/you/project" autocomplete="off" spellcheck="false" />
      <select id="chat-tier" class="chat-tier" aria-label="Tool tier">
        <option value="none">Chat only</option>
        <option value="read">+ Read files</option>
        <option value="full">+ Read &amp; run tools</option>
      </select>
    </div>
    <div id="chat-usage" class="chat-usage" hidden></div>
    <div id="chat-install" class="chat-pane" hidden>
      <p>Chat runs through a tiny local service (your keys never leave your machine):</p>
      <pre class="chat-cmd"><code>npx agenttoolbox-agent@latest</code></pre>
      <button id="chat-copy-cmd" type="button" class="cap-chip">Copy command</button>
      <p class="chat-sub">Waiting for the local service…</p>
    </div>
    <div id="chat-cc" class="chat-pane" hidden>
      <p>This model is only served by agentic harnesses. Your local service is running, but Claude Code isn't installed — install it, then reopen this chat:</p>
      <pre class="chat-cmd"><code>curl -fsSL https://claude.ai/install.sh | bash</code></pre>
      <button id="chat-cc-copy" type="button" class="cap-chip">Copy command</button>
      <p class="chat-sub">No need to reload this page — just click Chat → again once installed.</p>
    </div>
    <div id="chat-key" class="chat-pane" hidden>
      <p>This provider needs an API key. It's stored in your browser and sent only to your local agent.</p>
      <label for="chat-key-input">API key</label>
      <input id="chat-key-input" type="password" autocomplete="off" />
      <button id="chat-key-save" type="button">Save &amp; continue</button>
    </div>
    <div id="chat-main" class="chat-pane" hidden>
      <div id="chat-log" aria-live="polite"></div>
      <form id="chat-form">
        <textarea id="chat-input" rows="2" placeholder="Ask anything…"></textarea>
        <div class="chat-actions">
          <button type="submit" id="chat-send">Send</button>
          <button type="button" id="chat-abort" hidden>Stop</button>
        </div>
      </form>
    </div>
  </aside>
</BaseLayout>

<style>
  .provider { margin-top: 2.5rem; }
  .count { font-size: 0.85rem; font-weight: 500; color: var(--ink-soft); margin-left: 0.5rem; }
  .tablewrap { overflow-x: auto; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }
  .cap-filter { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1.25rem 0 0.5rem; }
  .cap-chip {
    background: var(--surface); color: var(--ink-soft);
    border: 1px solid var(--line-strong); border-radius: 999px;
    padding: 0.3rem 0.85rem; font-size: 0.85rem; font-weight: 500;
  }
  .cap-chip.is-active { background: var(--cobalt); color: #fff; border-color: var(--cobalt); }
  .provider.is-hidden, tr.is-hidden { display: none; }
  /* ---------- chat drawer ---------- */
  #chat-drawer {
    position: fixed; top: 0; right: 0; bottom: 0;
    width: min(430px, 100vw);
    background: var(--surface); border-left: 1px solid var(--line-strong);
    box-shadow: -12px 0 32px rgba(0,0,0,0.35);
    transform: translateX(102%); transition: transform .25s ease;
    display: flex; flex-direction: column; z-index: 60;
    padding: 1rem 1.1rem;
  }
  #chat-drawer.is-open { transform: translateX(0); }
  /* ---------- config drawer（与 chat 抽屉同一套开合机制） ---------- */
  .config-drawer {
    position: fixed; top: 0; right: 0; bottom: 0;
    width: min(480px, 100vw);
    background: var(--surface); border-left: 1px solid var(--line-strong);
    box-shadow: -12px 0 32px rgba(0,0,0,0.35);
    transform: translateX(102%); transition: transform .25s ease;
    display: flex; flex-direction: column; z-index: 61;
    padding: 1rem 1.1rem; overflow-y: auto;
  }
  .config-drawer.is-open { transform: translateX(0); }
  .config-body { display: flex; flex-direction: column; gap: .8rem; margin-top: .8rem; }
  .config-body .field-row { grid-template-columns: 1fr; }
  .config-body #g-out { margin: 0; max-height: 40vh; overflow: auto; white-space: pre-wrap; }
  .drawer-close, #chat-close { background: transparent; border: 0; color: var(--ink-soft); font-size: 1.1rem; cursor: pointer; padding: .2rem .4rem; }
  .chat-head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--line); padding-bottom: .6rem; }
  .chat-sub { font-size: .8rem; color: var(--ink-soft); }
  .chat-agent-row { display: flex; align-items: center; gap: .5rem; margin-top: .6rem; font-size: .85rem; color: var(--ink-soft); }
  .chat-agent { flex: 1; background: var(--surface); color: inherit; border: 1px solid var(--line-strong); border-radius: 6px; padding: .3rem .5rem; font-size: .85rem; }
  .chat-agent-hint { font-size: .8rem; color: #f5a524; margin: -.3rem 0 0; }
  .chat-config-row { display: flex; align-items: center; gap: .5rem; margin-top: .6rem; font-size: .85rem; }
  .chat-config-row label { color: var(--ink-soft); }
  /* global.css 给 input/select 设了 width:100% + margin-bottom:1.1rem：
     width:100% 会成为 flex 基准把目录输入框挤没，必须在这里覆写 */
  .chat-config-row input#chat-cwd { flex: 1; width: auto; min-width: 0; margin: 0; background: var(--surface); color: inherit; border: 1px solid var(--line-strong); border-radius: 6px; padding: .3rem .5rem; font-size: .85rem; }
  .chat-tier { flex: 0 0 auto; width: auto; margin: 0; background: var(--surface); color: inherit; border: 1px solid var(--line-strong); border-radius: 6px; padding: .3rem .4rem; font-size: .85rem; }
  .chat-usage { font-size: .8rem; color: var(--ink-soft); margin-top: .4rem; }
  .chat-pane { display: flex; flex-direction: column; gap: .6rem; overflow-y: auto; flex: 1; }
  .chat-pane[hidden] { display: none; } /* display:flex 会盖过 UA 的 [hidden]，需显式还原 */
  #chat-main { min-height: 0; }
  #chat-log { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .55rem; padding: .3rem 0; }
  /* chatMsg / 权限卡的节点全部是运行时 createElement 出来的，带不上 Astro 的
     scoped 属性（.chat-msg[data-astro-cid-x] 永不命中），必须 :global 化。
     顺带修正：此前气泡样式在生产构建里实际从未生效。 */
  :global(.chat-msg) { padding: .5rem .7rem; border-radius: 10px; white-space: pre-wrap; font-size: .92rem; }
  :global(.chat-msg--user) { background: var(--cobalt-wash); align-self: flex-end; }
  :global(.chat-msg--assistant) { background: rgba(127,127,127,0.12); align-self: flex-start; }
  :global(.chat-msg--error) { color: #ff8f8f; }
  :global(.chat-msg--thinking) { font-style: italic; color: var(--ink-soft); opacity: .85; font-size: .88rem; white-space: pre-wrap; }
  :global(.chat-msg--thinking.is-collapsed) { max-height: 2.6em; overflow-y: auto; opacity: .6; }
  :global(.chat-msg--activity) { color: var(--ink-soft); font-size: .82rem; }
  :global(.chat-msg--hint) { color: var(--ink-soft); font-size: .85rem; }
  /* 权限卡：full 级别动作逐个确认；底色用 cobalt-wash 与用户/助手气泡区分 */
  :global(.chat-perm) {
    background: var(--cobalt-wash); align-self: flex-start;
    display: flex; flex-direction: column; gap: .45rem;
    border: 1px solid var(--line-strong); white-space: normal;
  }
  :global(.chat-perm-head) { display: flex; align-items: center; }
  :global(.chat-perm-action) { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--cobalt); }
  :global(.chat-perm-summary) { font-family: var(--font-mono); font-size: .84rem; white-space: pre-wrap; word-break: break-word; color: var(--ink); }
  :global(.chat-perm-actions) { display: flex; gap: .5rem; }
  :global(.chat-perm-actions button) { padding: .3rem .9rem; font-size: .82rem; border-radius: 8px; }
  :global(.chat-perm-actions button.chat-perm-deny) { background: transparent; color: var(--ink); border-color: var(--line-strong); }
  :global(.chat-perm-actions button.chat-perm-deny:hover) { background: transparent; border-color: #ff8f8f; color: #ff8f8f; }
  :global(.chat-perm-actions button:disabled) { cursor: default; opacity: .5; }
  :global(.chat-perm-status) { font-size: .82rem; font-weight: 600; }
  :global(.chat-perm.is-approved), :global(.chat-perm.is-denied) { opacity: .6; }
  :global(.chat-perm.is-approved .chat-perm-status) { color: var(--cobalt); }
  :global(.chat-perm.is-denied .chat-perm-status) { color: #ff8f8f; }
  :global(.chat-perm.is-expired) { opacity: .45; }
  :global(.chat-perm.is-expired .chat-perm-status) { color: var(--ink-soft); font-weight: 500; }
  .chat-cmd { background: #0f1830; color: #e7ebf4; padding: .7rem .8rem; border-radius: 8px; overflow-x: auto; font-size: .85rem; }
  #chat-form textarea { width: 100%; resize: vertical; }
  .chat-actions { display: flex; gap: .6rem; margin-top: .4rem; }
  /* 表格列宽：Model 吃剩余宽度，其余列固定，避免 Config 列挤压换行（列宽由 <col> 内联 style 提供） */
  .tablewrap table { table-layout: fixed; min-width: 720px; }
  /* 提到 td 前缀：global.css 的 `code` 规则同权重但加载在后，会把 display/font 覆写掉 */
  td.col-model code.model-id { display: block; margin-top: .15rem; font-size: .8rem; color: var(--ink-soft); overflow-wrap: anywhere; }
  td.col-config { white-space: nowrap; }
  td.col-config button {
    padding: .25rem .7rem; font-size: .78rem; font-weight: 500;
    background: var(--surface); color: var(--cobalt);
    border: 1px solid var(--line-strong); border-radius: 6px; cursor: pointer;
  }
  td.col-config button + button { margin-left: .4rem; }
  td.col-config button:hover { border-color: var(--cobalt); }
</style>

<script>
  import data from '../data/free-models.json';
  import { generateConfig, type ConfigTarget } from '../lib/freeconfig';
  import { probeHealth, createSession, streamMessage, abortSession, fetchOpenRouterQuota, answerPermission, keyStorage, type ChatEvent, type OpenRouterQuota } from '../lib/agentchat';

  import { openDrawer, closeDrawers, stopScroll } from '../lib/drawer';

  const idx = data;
  const $ = (id: string) => document.getElementById(id)!;
  const configDrawer = $('config-drawer');
  const bothDrawers = () => [configDrawer, $('chat-drawer')] as HTMLElement[];
  const provSel = $('g-provider') as HTMLSelectElement;
  const modelSel = $('g-model') as HTMLSelectElement;
  const targetSel = $('g-target') as HTMLSelectElement;
  const out = $('g-out');
  const copy = $('g-copy') as HTMLButtonElement;
  let copyTimer: ReturnType<typeof setTimeout> | undefined;

  function fillModels() {
    const p = idx.providers.find((x) => x.id === provSel.value)!;
    // DOM 构建：模型 id/name 来自同步数据，不用 innerHTML 模板，杜绝注入面
    modelSel.innerHTML = '';
    p.models.forEach((m) => {
      const o = document.createElement('option');
      o.value = m.id;
      o.textContent = m.name;
      modelSel.append(o);
    });
  }

  function flash(msg: string) {
    copy.textContent = msg;
    clearTimeout(copyTimer);
    copyTimer = setTimeout(() => (copy.textContent = 'Copy'), 1500);
  }

  function render() {
    const p = idx.providers.find((x) => x.id === provSel.value)!;
    const m = p.models.find((x) => x.id === modelSel.value) ?? p.models[0];
    if (!m) { out.textContent = ''; return; }
    out.textContent = generateConfig(
      targetSel.value as ConfigTarget, p, m,
      ($('g-key') as HTMLInputElement).value,
    );
    copy.hidden = false;
  }

  provSel.addEventListener('change', () => { fillModels(); render(); });
  modelSel.addEventListener('change', render);
  targetSel.addEventListener('change', render);
  ($('gen-form') as HTMLFormElement).addEventListener('submit', (e) => { e.preventDefault(); render(); });

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(out.textContent ?? '');
      flash('Copied!');
    } catch {
      flash('Copy failed — select the text');
    }
  });

  // 表格里的 Configure → 打开右侧生成器抽屉（拦截锚点，页面不滚动）
  function openConfig(provider: string, model: string, label: string): void {
    provSel.value = provider;
    fillModels();
    modelSel.value = model;
    render();
    ($('config-pick-label') as HTMLElement).textContent = label;
    openDrawer(bothDrawers(), configDrawer);
    stopScroll(window);
  }
  document.querySelectorAll<HTMLElement>('.pick').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault(); // 仍是 <a href="#configure">：拦截锚点，页面不跳转
      const a = el as HTMLElement & { dataset: DOMStringMap };
      openConfig(a.dataset.provider!, a.dataset.model!, a.dataset.name ?? '');
    });
  });
  $('config-close').addEventListener('click', () => closeDrawers(bothDrawers()));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawers(bothDrawers()); });

  // 能力筛选：chip 点击 → 按 tr 的 data-caps 显隐整行，全空的 provider 节隐藏
  document.querySelectorAll<HTMLButtonElement>('.cap-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.cap-chip').forEach((c) => {
        c.classList.remove('is-active');
        c.setAttribute('aria-pressed', 'false');
      });
      chip.classList.add('is-active');
      chip.setAttribute('aria-pressed', 'true');
      const cap = chip.dataset.cap!;
      document.querySelectorAll<HTMLTableRowElement>('tr[data-caps]').forEach((tr) => {
        const show = cap === 'all' || tr.dataset.caps.split(' ').includes(cap);
        tr.classList.toggle('is-hidden', !show);
      });
      document.querySelectorAll<HTMLElement>('.provider').forEach((sec) => {
        // 只看 tbody 的数据行，thead 的 tr 不参与计数
        const any = sec.querySelectorAll('tbody tr:not(.is-hidden)').length > 0;
        sec.classList.toggle('is-hidden', !any);
      });
      const status = $('filter-status');
      if (status) {
        status.textContent = cap === 'all'
          ? `${document.querySelectorAll('tbody tr[data-caps]').length} models`
          : `${document.querySelectorAll('tbody tr[data-caps]:not(.is-hidden)').length} models match`;
      }
    });
  });

  fillModels();

  // ── Chat 抽屉：探测本地 agent → 建 session → SSE 聊天 ──
  const panes = {
    install: $('chat-install'), cc: $('chat-cc'), key: $('chat-key'), main: $('chat-main'),
  } as Record<string, HTMLElement>;
  const chatLog = $('chat-log');
  const chatInput = $('chat-input') as HTMLTextAreaElement;
  const sendBtn = $('chat-send') as HTMLButtonElement;
  const abortBtn = $('chat-abort') as HTMLButtonElement;
  const cwdInput = $('chat-cwd') as HTMLInputElement;
  const tierSel = $('chat-tier') as HTMLSelectElement;
  const usageEl = $('chat-usage');
  type ChatState = {
    provider: string; model: string; base: string; envKey: string;
    ctx: number; maxOut: number; name: string; anthropicApi: string;
    agents: string[]; // 网关适配器偏好序，来自 data-agents（如 ['cc','pi'] 或 ['pi']）
    agent: string | null; // 显式选择的 agent id（下拉）；null = 未选
    cwd: string; // 会话工作目录（read/full 级别才生效；'' = 用网关默认）
    toolTier: 'none' | 'read' | 'full'; // 工具级别（full = 写/执行，动作逐个经权限卡确认）
    sessionId: string | null; streaming: boolean; probeTimer?: ReturnType<typeof setInterval>;
    streamAbort?: AbortController;
  };
  let chat: ChatState | null = null;
  // 配置代数令牌：换 agent / 改 cwd / 改级别 / 换模型 / 关抽屉都自增。在途的
  // 建会话与额度请求在每个 await 之后核对令牌，不一致即整体放弃——否则连改
  // 两次配置，第二次的 UI 会配上第一次建出的会话（或额度行刷错模型）。
  let configGen = 0;
  // OpenRouter 额度行文案（建会话时刷一次）。usage 事件把每轮 token 用量追加
  // 在它后面而不是整体替换，否则第一轮 ACP 用量就把额度行冲掉了。
  let quotaText = '';
  // /health.agents 的缓存：openChat 时探测一次，填下拉
  let lastHealth: Awaited<ReturnType<typeof probeHealth>> = null;

  const AGENT_LABELS: Record<string, string> = {
    pi: 'pi', cc: 'Claude Code',
    'acp:hermes': 'Hermes', 'acp:openclaw': 'OpenClaw', 'acp:opencode': 'OpenCode',
    'acp:codex': 'Codex', 'acp:dsh': 'DeepSeek Harness',
  };
  const agentLabel = (id: string, name?: string) => AGENT_LABELS[id] ?? name ?? id;

  const showPane = (k: 'install' | 'cc' | 'key' | 'main') => {
    for (const [name, el] of Object.entries(panes)) el.hidden = name !== k;
  };
  // role 集合与实际调用点对齐（thinking/activity 由 SSE 分支传入，hint 为配置降级提示）
  const chatMsg = (role: 'user' | 'assistant' | 'error' | 'thinking' | 'activity' | 'hint', text: string) => {
    const div = document.createElement('div');
    div.className = `chat-msg chat-msg--${role}`;
    div.textContent = text;
    chatLog.append(div);
    chatLog.scrollTop = chatLog.scrollHeight;
    return div;
  };

  // 权限卡：full 级别下网关把每个敏感动作挂起等用户点头（SSE permission_request，
  // 120s 超时网关自动拒绝）。summary 是模型可控的路径/命令文本，只走 textContent。
  // 卡片在渲染时捕获 configGen/chat：点击是滞后的异步动作，onEvent 的 gen 守卫只管
  // 渲染那一下，应答 POST 绝不能打到换掉的新会话 sessionId 上。
  function appendPermCard(c: ChatState, gen: number, ev: { reqId: string; action: string; summary: string }): void {
    const card = document.createElement('div');
    card.className = 'chat-msg chat-perm';
    const head = document.createElement('div');
    head.className = 'chat-perm-head';
    const action = document.createElement('span');
    action.className = 'chat-perm-action';
    action.textContent = ev.action;
    head.append(action);
    const summary = document.createElement('div');
    summary.className = 'chat-perm-summary';
    summary.textContent = ev.summary;
    const actions = document.createElement('div');
    actions.className = 'chat-perm-actions';
    const approve = document.createElement('button');
    approve.type = 'button';
    approve.textContent = 'Approve';
    const deny = document.createElement('button');
    deny.type = 'button';
    deny.className = 'chat-perm-deny';
    deny.textContent = 'Deny';
    actions.append(approve, deny);
    card.append(head, summary, actions);
    const settle = (allowed: boolean) => {
      if (gen !== configGen || chat !== c) return; // 过期卡片：点了也不外发
      approve.disabled = true; // 先禁双按钮：双击/两键连点只发一次应答
      deny.disabled = true;
      void answerPermission(c.sessionId ?? '', ev.reqId, allowed).then((ok) => {
        if (gen !== configGen || chat !== c) return; // 等待期间配置重置：日志已清空，别碰 UI
        const status = document.createElement('div');
        status.className = 'chat-perm-status';
        if (ok) {
          card.classList.add(allowed ? 'is-approved' : 'is-denied');
          status.textContent = allowed ? 'Approved' : 'Denied';
        } else {
          // 网关 404 = 已超时/已收敛/回合取消；网络失败同判：卡片置灰为过期
          card.classList.add('is-expired');
          status.textContent = 'Expired';
        }
        actions.replaceChildren(status);
        chatLog.scrollTop = chatLog.scrollHeight;
      });
    };
    approve.addEventListener('click', () => settle(true));
    deny.addEventListener('click', () => settle(false));
    chatLog.append(card);
    chatLog.scrollTop = chatLog.scrollHeight;
  }

  function stopProbe() { if (chat?.probeTimer) { clearInterval(chat.probeTimer); chat.probeTimer = undefined; } }

  // 把 DOM 里的 cwd / 级别读进会话状态（调用方需先清空日志，降级提示才留得住）。
  // 工具级别（read/full）但目录为空：网关不会给它挂工具，与其静默建个无工具
  // 会话，不如强制降回 none 并把下拉框拨回去（UI 状态 = 实际发送的参数），同时提示。
  function readConfigFromUi(): void {
    const c = chat!;
    c.cwd = cwdInput.value.trim();
    c.toolTier = tierSel.value === 'read' || tierSel.value === 'full' ? tierSel.value : 'none';
    if (c.toolTier !== 'none' && !c.cwd) {
      c.toolTier = 'none';
      tierSel.value = 'none';
      chatMsg('hint', 'Tool tiers need a work dir — tier reset to "Chat only". Fill in the work dir above to enable file tools.');
    }
  }

  // 流式按钮复位（换 agent/模型、关抽屉、流的正常收尾都要走）：Send 恢复可点、Stop 隐藏。
  function resetStreamButtons(): void {
    sendBtn.disabled = false;
    abortBtn.hidden = true;
  }

  // 配置重置唯一入口（换 agent / 改 cwd / 改级别都汇到这里）：作废旧会话并重建。
  // 旧会话的在途流先中止，否则 send 卡在 disabled、Stop 按钮指向一个死会话。
  function resetSession(): void {
    const c = chat;
    if (!c) return;
    if (c.streaming && c.streamAbort) c.streamAbort.abort();
    c.streaming = false;
    resetStreamButtons();
    c.sessionId = null;
    configGen++; // 在途的建会话/额度结果因此作废（见各 await 后的核对）
    usageEl.hidden = true;
    usageEl.textContent = '';
    quotaText = '';
    void tryGoChat();
  }

  async function ensureSession(): Promise<void> {
    const c = chat!;
    if (c.sessionId) return;
    const gen = configGen;
    const res = await createSession({
      provider: c.provider, model: c.model, baseUrl: c.base || null,
      apiKey: keyStorage.get(c.provider),
      name: c.name, contextWindow: c.ctx, maxOutput: c.maxOut,
      agents: c.agents,
      anthropicApi: c.anthropicApi || null,
      agent: c.agent,
      // 工具级别（read/full）才带 cwd；级别/目录任一变化都建新会话（见 applyConfig）
      cwd: c.toolTier === 'none' ? null : (c.cwd || null),
      toolTier: c.toolTier,
    });
    // 建会话期间配置变了（连点两次/换模型）：迟到的 sessionId 属于旧配置，丢弃
    if (gen !== configGen || chat !== c) return;
    c.sessionId = res.sessionId;
  }

  // Agent 下拉：把 /health.agents 里可用的项填进去。≤1 个可用时隐藏（无意义 UI）。
  function fillAgentSelect(health: NonNullable<Awaited<ReturnType<typeof probeHealth>>>) {
    const sel = $('chat-agent') as HTMLSelectElement;
    const row = $('chat-agent-row');
    const available = (health.agents ?? []).filter((a) => a.available);
    sel.textContent = '';
    for (const a of available) {
      const o = document.createElement('option');
      o.value = a.id;
      o.textContent = agentLabel(a.id, a.name);
      sel.append(o);
    }
    // 记住上次选择（仍可用时）
    const saved = (() => { try { return localStorage.getItem('atbx:agent'); } catch { return null; } })();
    if (saved && available.some((a) => a.id === saved)) sel.value = saved;
    if (chat) chat.agent = sel.value || null;
    // ≤1 个可用 → 隐藏下拉：无意义的 UI
    row.hidden = available.length <= 1;
    updateAgentHint();
  }

  // 被 provider gate 到 harness 的模型（openrouter 免费档）：选了非 cc 的 agent
  // 时提前提示，避免用户发出必 403 的请求。
  function updateAgentHint() {
    const c = chat;
    const sel = $('chat-agent') as HTMLSelectElement;
    const hint = $('chat-agent-hint');
    if (!c || !hint) return;
    const needsCc = c.agents[0] === 'cc';
    const gatedPick = needsCc && sel.value && sel.value !== 'cc';
    hint.hidden = !gatedPick;
    if (gatedPick) {
      hint.textContent = 'This model is provider-gated to Claude Code — other agents will get a 403. Switch the Agent above to Claude Code.';
    }
  }

  // OpenRouter 额度行文案：有明确限额 → 已用/限额；无限额按是否免费档区分
  const formatQuota = (q: OpenRouterQuota): string =>
    q.limit != null
      ? `已用 ${q.usage ?? 0} · 限额 ${q.limit} 请求/天`
      : q.isFreeTier === true ? '免费档 50/天' : '不限';

  async function tryGoChat(): Promise<void> {
    const c = chat!;
    const gen = configGen;
    const stale = () => gen !== configGen || chat !== c;
    const health = await probeHealth();
    if (!health) {
      // 旧轮次别再切面板/重装轮播，新一轮自会处理；否则旧 timer 泄漏
      if (stale()) return;
      showPane('install'); stopProbe(); c.probeTimer = setInterval(tryGoChat, 3000); return;
    }
    stopProbe();
    if (stale()) return;
    lastHealth = health;
    fillAgentSelect(health);
    // 该模型只能跑在 CC 上，而本机没装 CC：给安装引导（不轮询——安装要用户时间，装完重开即可）
    const needsCc = c.agents[0] === 'cc';
    const ccOk = health.agents?.find((a) => a.id === 'cc')?.available === true;
    if (needsCc && !ccOk) { showPane('cc'); return; }
    if (!keyStorage.get(c.provider)) { showPane('key'); return; }
    try {
      await ensureSession();
      if (stale()) return;
      showPane('main');
      chatInput.focus();
      // OpenRouter 额度展示：有 key 才查（经网关代理）；其他 provider 不显示。
      // 放在 showPane('main') 后异步刷，不阻塞输入框聚焦。
      usageEl.hidden = true;
      if (c.provider === 'openrouter') {
        const key = keyStorage.get(c.provider);
        if (key) {
          const q = await fetchOpenRouterQuota(key);
          // 查询失败（q 为 null）→ 额度行留空，不刷错误；期间配置变了也别写
          if (q && !stale()) {
            quotaText = formatQuota(q);
            usageEl.hidden = false;
            usageEl.textContent = quotaText;
          }
        }
      }
    }
    // 建会话失败（典型：read 级别给了不存在的 cwd → 网关 400）留在主面板：
    // 错误进日志才看得见——跳 key 面板会把 chatLog 连同错误一起藏掉。
    // 配置已换则这轮的错误属于旧参数，不展示（新一轮自会报自己的）。
    catch (e) { if (!stale()) { chatMsg('error', String((e as Error).message)); showPane('main'); } }
  }

  function openChat(a: HTMLAnchorElement) {
    stopProbe(); // 上一次会话（若在等本地服务）的轮询要停掉，否则旧 timer 会打到新 chat 上
    chat?.streamAbort?.abort(); // 上一个会话还在流式：一并中止，别让旧流写进新对话
    // 旧流的 finally 会因下面的 gen++ 跳过按钮复位，这里得自己复位，否则新对话
    // 的 Send 停在 disabled、Stop 指向死会话
    resetStreamButtons();
    configGen++; // 上一个模型在途的建会话/额度结果一并作废
    chat = {
      provider: a.dataset.provider!, model: a.dataset.model!, base: a.dataset.base ?? '',
      anthropicApi: a.dataset.anthropic ?? '',
      envKey: a.dataset.envkey ?? '', ctx: Number(a.dataset.ctx), maxOut: Number(a.dataset.maxout),
      name: a.dataset.name ?? '',
      agents: (a.dataset.agents ?? 'pi').split(',').map((s) => s.trim()).filter(Boolean),
      agent: null,
      cwd: '', toolTier: 'none',
      sessionId: null, streaming: false,
    };
    $('chat-model-name').textContent = chat.name;
    $('chat-provider-name').textContent = `${chat.provider} · ${chat.model}`;
    chatLog.textContent = '';
    // 恢复上次的 cwd/级别（localStorage 可选）。输入框是唯一事实来源：
    // 先回填 DOM，再同步进 chat 状态，保证 UI 与实际建会话的参数一致。
    try {
      cwdInput.value = localStorage.getItem('atbx:cwd') ?? '';
      const savedTier = localStorage.getItem('atbx:tier');
      tierSel.value = savedTier === 'read' || savedTier === 'full' ? savedTier : 'none';
    } catch { /* 隐身模式等 */ }
    readConfigFromUi(); // 空目录 + read → 降级 none 并提示
    // 配置行随抽屉开合：开 = 显示（跨面板常驻，key/安装引导时也能先填好）
    $('chat-config-row').hidden = false;
    usageEl.hidden = true; // 上一个模型的额度别残留
    usageEl.textContent = '';
    quotaText = '';
    // 上次缓存的 health 直接先填一次下拉（避免闪烁）；tryGoChat 成功后再刷新
    if (lastHealth) fillAgentSelect(lastHealth);
    openDrawer(bothDrawers(), $('chat-drawer'));
    void tryGoChat();
  }

  document.querySelectorAll<HTMLButtonElement>('button.chat-pick').forEach((a) => {
    a.addEventListener('click', (e) => { e.preventDefault(); openChat(a); });
  });
  $('chat-close').addEventListener('click', () => {
    closeDrawers(bothDrawers());
    stopProbe();
    chat?.streamAbort?.abort();
    resetStreamButtons(); // 旧流的 finally 因 gen++ 会跳过复位，重开前的按钮先归位
    configGen++; // 抽屉关了 = 会话作废：在途的建会话/额度结果别再落 UI
    $('chat-config-row').hidden = true;
    usageEl.hidden = true;
  });
  $('chat-copy-cmd').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText('npx agenttoolbox-agent@latest'); } catch { /* 手选 */ }
  });
  $('chat-cc-copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText('curl -fsSL https://claude.ai/install.sh | bash'); } catch { /* 手选 */ }
  });
  $('chat-key-save').addEventListener('click', () => {
    const v = ($('chat-key-input') as HTMLInputElement).value.trim();
    if (!v || !chat) return;
    keyStorage.set(chat.provider, v);
    void tryGoChat();
  });

  // 换 agent = 换会话（不同 agent 的上下文互不相通）。记住选择供下次预选。
  $('chat-agent').addEventListener('change', (e) => {
    const sel = e.target as HTMLSelectElement;
    if (!chat) return;
    try { localStorage.setItem('atbx:agent', sel.value); } catch { /* 隐身模式等 */ }
    chat.agent = sel.value;
    updateAgentHint();
    chatLog.textContent = ''; // 旧 agent 的对话随旧会话作废
    resetSession();
  });

  // cwd / 级别变更 = 新会话（运行中的 agent 不能中途搬家：工具闭包绑定 cwd，
  // tier 决定工具在不在，网关侧按 cacheKey 重建）。与 Agent 下拉的变化叠加生效。
  const applyConfig = () => {
    if (!chat) return;
    chatLog.textContent = ''; // 先清：readConfigFromUi 的降级提示要落在新对话开头
    readConfigFromUi();
    try {
      localStorage.setItem('atbx:cwd', chat.cwd);
      localStorage.setItem('atbx:tier', chat.toolTier);
    } catch { /* 隐身模式等 */ }
    resetSession(); // 新会话，per-turn 用量与额度行作废（resetSession 内处理）
  };
  cwdInput.addEventListener('change', applyConfig);
  tierSel.addEventListener('change', applyConfig);

  $('chat-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const c = chat;
    if (!c?.sessionId || c.streaming) return;
    const text = chatInput.value.trim();
    if (!text) return;
    chatInput.value = '';
    chatMsg('user', text);
    const outDiv = chatMsg('assistant', '');
    // 思维链/工具活动：弱化样式的独立元素，与正式回复分开
    let thinkDiv: HTMLDivElement | null = null;
    const gen = configGen; // 中途配置重置会让这轮流作废（abort），收尾时据此不碰 UI
    c.streaming = true; sendBtn.disabled = true; abortBtn.hidden = false;
    c.streamAbort = new AbortController();
    abortBtn.onclick = () => { c.streamAbort?.abort(); void abortSession(c.sessionId!); };
    try {
      await streamMessage(c.sessionId, text, (ev: ChatEvent) => {
        if (ev.type === 'delta') {
          // 首个正式回复到达时折叠思维链，让正文占据视觉主体
          if (thinkDiv) { thinkDiv.classList.add('is-collapsed'); thinkDiv = null; }
          outDiv.textContent += ev.text;
        }
        else if (ev.type === 'thinking') {
          if (gen !== configGen || chat !== c) return; // 迟到事件别写新对话的日志
          if (!thinkDiv) thinkDiv = chatMsg('thinking', '');
          thinkDiv.textContent += ev.text;
        }
        else if (ev.type === 'activity') {
          if (gen !== configGen || chat !== c) return;
          chatMsg('activity', `⚙ ${ev.title}`);
        }
        // full 级别的工具审批：插入权限卡，点击应答后网关唤醒挂起的适配器，
        // 后续 delta 走正常 SSE 流（无需额外接线）。
        else if (ev.type === 'permission_request') {
          if (gen !== configGen || chat !== c) return; // 迟到事件别写新对话的日志
          appendPermCard(c, gen, ev);
        }
        // ACP 的 usage_update（{used,size,cost?}）；pi/cc 无此事件时保持隐藏。
        // 追加在额度行后而非替换，否则第一轮用量就把 OpenRouter 额度文案冲掉。
        else if (ev.type === 'usage' && ev.usage) {
          const u = ev.usage;
          if (gen !== configGen || chat !== c) return; // 迟到事件别写新会话的用量行
          const line = `上下文：${u.used ?? '?'}/${u.size ?? '?'} tokens`;
          usageEl.hidden = false;
          usageEl.textContent = quotaText ? `${quotaText} · ${line}` : line;
        }
        else if (ev.type === 'error') outDiv.textContent += `\n[error] ${ev.message}`;
        chatLog.scrollTop = chatLog.scrollHeight;
      }, c.streamAbort.signal);
    } catch { outDiv.textContent += '\n[connection closed]'; }
    // 配置已重置/换模型时不碰按钮：新一轮 resetSession 已复位过 UI，
    // 迟到的收尾若再复位，会把新一轮正在跑的流误解锁
    finally { if (gen === configGen && chat === c) { c.streaming = false; sendBtn.disabled = false; abortBtn.hidden = true; } }
  });
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ($('chat-form') as HTMLFormElement).requestSubmit(); }
  });
</script>
